@@ -201,7 +201,11 @@
 static void 
 cpu_run_id(uint32_t eax, uint32_t ecx, uint32_t *abcd)
 {
-#if defined(_MSC_VER)
+#if defined(__EMSCRIPTEN__)
+  /* WebAssembly: no cpuid; SSE is emulated on wasm SIMD128 (see cpu_has_sse*) */
+  (void) eax; (void) ecx;
+  abcd[0] = abcd[1] = abcd[2] = abcd[3] = 0;
+#elif defined(_MSC_VER)
   __cpuidex(abcd, eax, ecx);
 #else
   uint32_t ebx = 0;
@@ -280,6 +284,9 @@
 static int
 cpu_has_sse(void)
 {
+#if defined(__EMSCRIPTEN__)
+  return 1;  /* compiled with -msimd128 emulation */
+#endif
   uint32_t abcd[4];
   uint32_t sse2_mask =  (1 << 25) |  // edx: SSE
                         (1 << 26);   //      SSE2
@@ -301,6 +308,9 @@
 static int
 cpu_has_sse4(void)
 {
+#if defined(__EMSCRIPTEN__)
+  return 1;  /* compiled with -msimd128 emulation */
+#endif
   uint32_t abcd[4];
   uint32_t sse2_mask =  (1 << 25) |  // edx: SSE
                         (1 << 26);   //      SSE2
